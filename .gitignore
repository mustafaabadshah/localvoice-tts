# Downloaded TTS models — NOT redistributed with this repository.
# scripts/setup.ps1 (Piper) and scripts/install_kokoro.ps1 (Kokoro) fetch them on first run,
# and backend/app/services/voice_manager.py discovers whatever lands in backend/voices/.
backend/voices/*.onnx
backend/voices/*.onnx.json
backend/voices/*.bin
backend/voices/piper/
backend/voices/kokoro/

